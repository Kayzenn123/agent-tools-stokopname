---
// StokOpname "Depo 32" — design tokens dari seed 2026-11-14 (dark/triadic hue 32).
// Palet disempurnakan: kontras teks/bg ~15:1, muted/bg ~7:1, aksen hijau/bg ~7:1 (AA lolos).
---

<style is:inline>
  :root {
    --font-esteban: var(--font-esteban);
    --font-catamaran: var(--font-catamaran);
    --font-playwrite: var(--font-playwrite);

    --bg: oklch(0.15 0.059 32);
    --surface: oklch(0.21 0.04 32);
    --surface-2: oklch(0.24 0.045 32);
    --line: oklch(0.32 0.05 32);
    --text: oklch(0.94 0.02 32);
    --muted: oklch(0.65 0.03 32);
    --accent: oklch(0.6 0.266 152);
    --accent-ink: oklch(0.16 0.05 152);
    --accent-2: oklch(0.58 0.235 272);
    --pop: oklch(0.85 0.236 188);
    --danger: oklch(0.62 0.24 25);

    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);

    --aw-font-sans: var(--font-catamaran), system-ui, sans-serif;
    --aw-font-serif: var(--font-esteban), Georgia, serif;
    --aw-font-heading: var(--font-esteban), Georgia, serif;

    --aw-color-primary: var(--accent);
    --aw-color-secondary: var(--accent-2);
    --aw-color-accent: var(--pop);

    --aw-color-text-heading: var(--text);
    --aw-color-text-default: var(--text);
    --aw-color-text-muted: var(--muted);
    --aw-color-bg-page: var(--bg);
    --aw-color-bg-page-dark: var(--bg);

    ::selection {
      background-color: var(--accent);
      color: var(--accent-ink);
    }

    :focus-visible {
      outline: 2px solid var(--pop);
      outline-offset: 3px;
      border-radius: 2px;
    }
  }

  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
